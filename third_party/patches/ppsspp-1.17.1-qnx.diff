+   struct timespec ts;
+   runSum += runUs;
+   ++calls;
+   if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts) == 0)
+      glCpu = (uint64_t)ts.tv_sec * 1000000u + (uint64_t)ts.tv_nsec / 1000u;
+   if (!last) { last = now; lastGlCpu = glCpu; return; }
+   if (now - last < 10000000u) return;
+   QNXPerfCounters &c = QNXPerf();
+   uint64_t frames = c.emuFrames, emuUs = c.emuUs, emuCpu = c.emuCpuUs, steps = c.runStepsUs, rb = c.readbacks, rbUs = c.readbackUs;
+   NOTICE_LOG(G3D, "QNX_PERF wall_ms=%u emu_frames=%u emu_ms=%u emu_cpu_ms=%u gl_run_ms=%u gl_cpu_ms=%u gl_steps_ms=%u readbacks=%u readback_ms=%u calls=%u depth_calls=%u depth_zdiff=%u depth_sizediff=%u depth_notneeded=%u depth_copied=%u depth_skipped=%u depth_sharers_max=%u",
+      (unsigned)((now - last) / 1000), (unsigned)(frames - lastEmuFrames), (unsigned)((emuUs - lastEmuUs) / 1000),
+      (unsigned)((emuCpu - lastEmuCpu) / 1000), (unsigned)((runSum - lastRunSum) / 1000), (unsigned)((glCpu - lastGlCpu) / 1000),
+      (unsigned)((steps - lastSteps) / 1000), (unsigned)(rb - lastRb), (unsigned)((rbUs - lastRbUs) / 1000), (unsigned)calls,
+      (unsigned)c.depthCalls.exchange(0), (unsigned)c.depthZMismatch.exchange(0), (unsigned)c.depthSizeMismatch.exchange(0),
+      (unsigned)c.depthNotNeeded.exchange(0), (unsigned)c.depthCopied.exchange(0), (unsigned)c.depthSkipped.exchange(0),
+      (unsigned)c.depthShareMax.exchange(0));
+   {
+      // ID6 v30: where the time goes. All values are deltas over this report's window.
+      static uint64_t pv[24];
+      static int pvc, pflips, pdraws, pflush, pverts, puncached, phashed, phashb, pdecoded, pinval, pfbup, pclears, pcc, pbt;
+      const int vc = __DisplayGetVCount();
+      uint64_t now[24] = { c.emuFenceWaitUs, c.syncWaitUs, c.syncs, c.glIdleUs, c.runs, c.syncRuns, c.initUs, c.pushUs,
+         c.dlUs, c.dlLists, c.texBuilds, c.texBuildUs, c.jitCompiles, c.jitClears, c.jitInvals };
+      #define QD(i) (unsigned)(now[i] - pv[i])
+      #define QDMS(i) (unsigned)((now[i] - pv[i]) / 1000)
+      static uint64_t pskipped;
+      const uint64_t skippedNow = c.skipped;
+      NOTICE_LOG(G3D, "QNX_SPEED vblanks=%d flips=%d skipped=%u mode=%c",
+         vc - pvc, (int)((unsigned)gpuStats.numFlips - (unsigned)pflips), (unsigned)(skippedNow - pskipped),
+         'A' + c.mode.load());
+      pskipped = skippedNow;
+      NOTICE_LOG(G3D, "QNX_WAIT emu_fence_ms=%u sync_n=%u sync_ms=%u gl_idle_ms=%u runs=%u sync_runs=%u",
+         QDMS(0), QD(2), QDMS(1), QDMS(3), QD(4), QD(5));
+      QNXGLCounters &g = QNXGL();
+      static QNXGLCounters pg;
+      NOTICE_LOG(G3D, "QNX_GLTIME init_ms=%u push_ms=%u texup_n=%u texup_kb=%u texup_ms=%u bufup_n=%u bufup_kb=%u bufup_ms=%u orphans=%u",
+         QDMS(6), QDMS(7), (unsigned)(g.texUploads - pg.texUploads), (unsigned)((g.texUploadBytes - pg.texUploadBytes) / 1024),
+         (unsigned)((g.texUploadUs - pg.texUploadUs) / 1000), (unsigned)(g.bufUploads - pg.bufUploads),
+         (unsigned)((g.bufUploadBytes - pg.bufUploadBytes) / 1024), (unsigned)((g.bufUploadUs - pg.bufUploadUs) / 1000),
+         (unsigned)(g.bufOrphans - pg.bufOrphans));
+      NOTICE_LOG(G3D, "QNX_GLCMD passes=%u cmds=%u draws=%u progs=%u texbinds=%u uniforms=%u blits=%u copies=%u readbacks=%u",
+         (unsigned)(g.passes - pg.passes), (unsigned)(g.cmds - pg.cmds), (unsigned)(g.draws - pg.draws),
+         (unsigned)(g.progs - pg.progs), (unsigned)(g.texBinds - pg.texBinds), (unsigned)(g.uniforms - pg.uniforms),
+         (unsigned)(g.blits - pg.blits), (unsigned)(g.copies - pg.copies), (unsigned)(g.readbacks - pg.readbacks));
+      pg = g;
+      NOTICE_LOG(G3D, "QNX_EMU dl_ms=%u dl_lists=%u texbuild_n=%u texbuild_ms=%u jit_compiles=%u jit_clears=%u jit_invals=%u",
+         QDMS(8), QD(9), QD(10), QDMS(11), QD(12), QD(13), QD(14));
+      {  // ID6 v33
+         QNXPerfCounters &qio = QNXPerf();
+         static uint64_t pioUs, pioReads, pioBytes, pioSlow;
+         const uint64_t ioUs = qio.ioUs, ioReads = qio.ioReads, ioBytes = qio.ioBytes, ioSlow = qio.ioSlow;
+         NOTICE_LOG(G3D, "QNX_IO reads=%u kb=%u ms=%u max_ms=%u slow=%u", (unsigned)(ioReads - pioReads),
+            (unsigned)((ioBytes - pioBytes) / 1024), (unsigned)((ioUs - pioUs) / 1000), (unsigned)(qio.ioMaxUs.exchange(0) / 1000),
+            (unsigned)(ioSlow - pioSlow));
+         pioUs = ioUs; pioReads = ioReads; pioBytes = ioBytes; pioSlow = ioSlow;
+      }
+      #undef QD
+      #undef QDMS
+      NOTICE_LOG(G3D, "QNX_GE draws=%u flushes=%u verts=%u uncached=%u hashed=%u hash_kb=%u decoded=%u tex_inval=%u fb_up=%u clears=%u ccopy=%u blocktx=%u",
+         (unsigned)gpuStats.numDrawCalls - (unsigned)pdraws, (unsigned)gpuStats.numFlushes - (unsigned)pflush,
+         (unsigned)gpuStats.numVertsSubmitted - (unsigned)pverts, (unsigned)gpuStats.numUncachedVertsDrawn - (unsigned)puncached,
+         (unsigned)gpuStats.numTexturesHashed - (unsigned)phashed,
+         ((unsigned)gpuStats.numTextureDataBytesHashed - (unsigned)phashb) / 1024u,
+         (unsigned)gpuStats.numTexturesDecoded - (unsigned)pdecoded, (unsigned)gpuStats.numTextureInvalidations - (unsigned)pinval,
+         (unsigned)gpuStats.numUploads - (unsigned)pfbup, (unsigned)gpuStats.numClears - (unsigned)pclears,
+         (unsigned)gpuStats.numColorCopies - (unsigned)pcc, (unsigned)gpuStats.numBlockTransfers - (unsigned)pbt);
+      pvc = vc; pflips = gpuStats.numFlips; pdraws = gpuStats.numDrawCalls; pflush = gpuStats.numFlushes;
+      pverts = gpuStats.numVertsSubmitted; puncached = gpuStats.numUncachedVertsDrawn; phashed = gpuStats.numTexturesHashed;
+      phashb = gpuStats.numTextureDataBytesHashed; pdecoded = gpuStats.numTexturesDecoded; pinval = gpuStats.numTextureInvalidations;
+      pfbup = gpuStats.numUploads; pclears = gpuStats.numClears; pcc = gpuStats.numColorCopies; pbt = gpuStats.numBlockTransfers;
+      for (int i = 0; i < 24; ++i) pv[i] = now[i];
+   }
+   last = now; lastRunSum = runSum; lastEmuFrames = frames; lastEmuUs = emuUs; lastEmuCpu = emuCpu; lastGlCpu = glCpu;
+   lastSteps = steps; lastRb = rb; lastRbUs = rbUs; calls = 0;
+}
