diff -ruN --strip-trailing-cr a/Common/GPU/OpenGL/QNXPerf.h b/Common/GPU/OpenGL/QNXPerf.h
--- a/Common/GPU/OpenGL/QNXPerf.h	1970-01-01 00:00:00.000000000 +0000
+++ b/Common/GPU/OpenGL/QNXPerf.h	2026-11-24 23:15:27.018248152 +0000
@@ -0,0 +1,53 @@
+#pragma once
+// ID6 car build: timing counters for the QNX_PERF log line (libretro.cpp prints them every 10 s).
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+struct QNXPerfCounters {
+	std::atomic<uint64_t> readbacks{0}, readbackUs{0}, runStepsUs{0};
+	std::atomic<uint64_t> emuFrames{0}, emuUs{0}, emuCpuUs{0};
+	// BlitFramebufferDepth outcomes (reset by each QNX_PERF report).
+	std::atomic<uint64_t> depthCalls{0}, depthZMismatch{0}, depthSizeMismatch{0}, depthNotNeeded{0};
+	std::atomic<uint64_t> depthCopied{0}, depthSkipped{0}, depthShareMax{0};
+	// Fragment test lookup texture (FragmentTestCacheGLES), reset by each QNX_PERF report.
+	std::atomic<uint64_t> fsLutCreate{0}, fsLutBind{0}, fsLutSkip{0};
+	// v17 alpha-test paths (ApplyDrawStateLate), reset by each QNX_PERF report.
+	std::atomic<uint64_t> atMath{0}, atFullSkip{0}, atFullSkipZ{0};
+	// v18 alpha ref checks: frontend (program's last upload vs draw) and GPU readback (sampled).
+	std::atomic<uint64_t> refChecks{0}, refStale{0}, gpuRefChecks{0}, gpuRefBad{0};
+	// v30: thread hand-off waits (cumulative us / counts).
+	std::atomic<uint64_t> emuFenceWaitUs{0}, syncWaitUs{0}, syncs{0}, glIdleUs{0}, runs{0}, syncRuns{0};
+	std::atomic<uint64_t> initUs{0}, pushUs{0};
+	// v30: emu-thread work.
+	std::atomic<uint64_t> dlUs{0}, dlLists{0}, texBuilds{0}, texBuildUs{0}, jitCompiles{0}, jitClears{0}, jitInvals{0};
+	// v31: in-run mode rotation (0..3 = A..D), push-buffer orphaning switch, skipped frames.
+	std::atomic<int> mode{0};
+	std::atomic<bool> orphan{false};
+	std::atomic<uint64_t> skipped{0};
+	// v33: LocalFileLoader::ReadAt timing (cumulative; max is reset by each report).
+	std::atomic<uint64_t> ioUs{0}, ioReads{0}, ioBytes{0}, ioMaxUs{0}, ioSlow{0};
+};
+inline QNXPerfCounters &QNXPerf();
+
+// v30: GL-thread-only counters (written and read on the GL thread, so no atomics).
+struct QNXGLCounters {
+	uint64_t passes, cmds, draws, progs, texBinds, uniforms, blits, copies, readbacks;
+	uint64_t texUploads, texUploadBytes, texUploadUs, bufUploads, bufUploadBytes;
+	uint64_t bufUploadUs, bufOrphans;  // v31
+};
+inline QNXGLCounters &QNXGL() { static QNXGLCounters c; return c; }
+inline QNXPerfCounters &QNXPerf() { static QNXPerfCounters c; return c; }
+
+inline uint64_t QNXNowUs() {
+	return (uint64_t)std::chrono::duration_cast<std::chrono::microseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+// Adds the scope's wall time (us) to a counter.
+struct QNXScopeUs {
+	std::atomic<uint64_t> &sum;
+	uint64_t start;
+	explicit QNXScopeUs(std::atomic<uint64_t> &s) : sum(s), start(QNXNowUs()) {}
+	~QNXScopeUs() { sum += QNXNowUs() - start; }
+};
