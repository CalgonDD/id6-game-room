+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+		glGenFramebuffers(1, &qnxProbeFbo);
+		glBindFramebuffer(GL_FRAMEBUFFER, qnxProbeFbo);
+		glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, qnxProbeTex, 0);
+		const GLenum pstatus = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+		static const char *pvs =
+			"attribute vec2 a_qpos;\n"
+			"varying mediump vec2 v_uv;\n"
+			"void main() { v_uv = a_qpos * 0.5 + 0.5; gl_Position = vec4(a_qpos, 0.0, 1.0); }\n";
+		static const char *pfs =
+			"precision mediump float;\n"
+			"uniform sampler2D tex;\n"
+			"varying mediump vec2 v_uv;\n"
+			"void main() { gl_FragColor = texture2D(tex, v_uv); }\n";
+		GLuint s1 = QNXSelfTestCompile(GL_VERTEX_SHADER, pvs);
+		GLuint s2 = QNXSelfTestCompile(GL_FRAGMENT_SHADER, pfs);
+		GLint linked = 0;
+		if (s1 && s2) {
+			qnxProbeProg = glCreateProgram();
+			glAttachShader(qnxProbeProg, s1);
+			glAttachShader(qnxProbeProg, s2);
+			glBindAttribLocation(qnxProbeProg, qnxProbeAttr, "a_qpos");
+			glLinkProgram(qnxProbeProg);
+			glGetProgramiv(qnxProbeProg, GL_LINK_STATUS, &linked);
+			if (linked) {
+				glUseProgram(qnxProbeProg);
+				glUniform1i(glGetUniformLocation(qnxProbeProg, "tex"), 0);
+			}
+		}
+		if (s1)
+			glDeleteShader(s1);
+		if (s2)
+			glDeleteShader(s2);
+		qnxProbeReady = pstatus == GL_FRAMEBUFFER_COMPLETE && linked;
+		NOTICE_LOG(G3D, "QNX_TPROBE init ready=%d fbo=0x%x linked=%d attr=%d", qnxProbeReady ? 1 : 0, (unsigned)pstatus, (int)linked,
+			(int)qnxProbeAttr);
+	}
+
+	// Restore.
+	glBindFramebuffer(GL_FRAMEBUFFER, (GLuint)fb);
+	glDeleteFramebuffers(1, &fbo);
+	glBindTexture(GL_TEXTURE_2D, (GLuint)tex0);
+	glDeleteTextures(2, texs);
+	glActiveTexture((GLenum)activeTex);
+	glUseProgram((GLuint)prog);
+	glBindBuffer(GL_ARRAY_BUFFER, (GLuint)arrayBuf);
+	if (attr0)
+		glEnableVertexAttribArray(0);
+	else
+		glDisableVertexAttribArray(0);
+	glViewport(vp[0], vp[1], vp[2], vp[3]);
+	glColorMask(colorMask[0], colorMask[1], colorMask[2], colorMask[3]);
+	glClearColor(clearColor[0], clearColor[1], clearColor[2], clearColor[3]);
+	glPixelStorei(GL_PACK_ALIGNMENT, packAlign);
+	glPixelStorei(GL_UNPACK_ALIGNMENT, unpackAlign);
+	for (int i = 0; i < 6; ++i) {
+		if (capOn[i])
+			glEnable(caps[i]);
+	}
+	NOTICE_LOG(G3D, "QNX_ASELF done fbo=0x%x restore_err=0x%x", (unsigned)status, (unsigned)glGetError());
+}
