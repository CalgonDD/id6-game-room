@@ -42,3 +42,31 @@
 	}
 	return true;
 }
+
+#if defined(__QNX__) && !defined(DEBUG_OPENGL)
+// Each distinct (error, file, line) is logged once, then again at counts 10, 100, 1000 and 10000, so the log shows
+// both where the driver rejects a call and how often. At most 40 places are tracked.
+void QNXTraceGLError(const char *file, int line) {
+	static struct { const char *file; int line; GLenum err; unsigned count; } seen[40];
+	static int used;
+	GLenum err = glGetError();
+	if (err == GL_NO_ERROR)
+		return;
+	for (int i = 0; i < used; ++i) {
+		if (seen[i].line == line && seen[i].err == err && seen[i].file == file) {
+			unsigned n = ++seen[i].count;
+			if (n == 10 || n == 100 || n == 1000 || n == 10000)
+				NOTICE_LOG(G3D, "QNX_GL_ERROR %s (0x%x) at %s:%d count=%u", GLEnumToString(err).c_str(), (unsigned)err, file, line, n);
+			return;
+		}
+	}
+	if (used >= 40)
+		return;
+	seen[used].file = file;
+	seen[used].line = line;
+	seen[used].err = err;
+	seen[used].count = 1;
+	++used;
+	NOTICE_LOG(G3D, "QNX_GL_ERROR %s (0x%x) at %s:%d count=1", GLEnumToString(err).c_str(), (unsigned)err, file, line);
+}
+#endif
