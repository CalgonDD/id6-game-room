+#include <cstdio>
+
+extern "C" __attribute__((visibility("default"))) int retro_id6_vertex_portable_probe(unsigned *completed) {
+    *completed=0;
+    alignas(16) unsigned char aligned[4096], shifted[4096], reference[8192], output[8192];
+    const unsigned colors[]={GE_VTYPE_COL_NONE,GE_VTYPE_COL_565,GE_VTYPE_COL_5551,GE_VTYPE_COL_4444};
+    VertexDecoderOptions options={true,true,false,true};
+    UVScale uv={}; uv.uScale=1.0f; uv.vScale=1.0f;
+    for(unsigned tc=0;tc<3;tc++)for(unsigned col:colors)for(unsigned normal=0;normal<3;normal++)for(unsigned pos=1;pos<3;pos++) {
+        unsigned fmt=tc|col|(normal<<5)|(pos<<7);
+        VertexDecoder decoder;
+        decoder.SetVertexType(fmt,options,nullptr);
+        unsigned inBytes=decoder.VertexSize()*32, outBytes=decoder.GetDecVtxFmt().stride*32;
+        if(inBytes+2>sizeof shifted || outBytes>sizeof output)return 2;
+        for(unsigned i=0;i<inBytes;i++)aligned[i]=(unsigned char)(i*13+7);
+        memcpy(shifted+2,aligned,inBytes);
+        memset(reference,0,sizeof reference);memset(output,0,sizeof output);
+        decoder.DecodeVerts(reference,aligned,&uv,0,31);
+        decoder.DecodeVerts(output,shifted+2,&uv,0,31);
+        if(memcmp(reference,output,sizeof reference))return 3;
+        // Also exercise a nonzero first index, as in deferred draw batches.
+        memset(reference,0,sizeof reference);memset(output,0,sizeof output);
+        decoder.DecodeVerts(reference,aligned,&uv,1,31);
+        decoder.DecodeVerts(output,shifted+2,&uv,1,31);
+        if(memcmp(reference,output,sizeof reference))return 4;
+        ++*completed;
+    }
+    printf("VERTEX_PORTABLE_CASES_PASS count=%u\n",*completed);
+    return 0;
+}
+
+
+#include "Common/MemoryUtil.h"
+extern "C" __attribute__((visibility("default"))) int retro_id6_texture_allocator_probe(unsigned *completed) {
+    *completed = 0;
+    for (unsigned i = 0; i < 64; ++i) {
+        size_t n = 1024 + i * 8192;
+        void *p = AllocateAlignedMemory(n, 16);
+        if (!p || (uintptr_t)p % 16) return 3;
+        printf("TEXTURE_ALLOC_SEQUENCE case=%u bytes=%u\n", i, (unsigned)n);
+        for (size_t k = 0; k < n; ++k) ((volatile unsigned char *)p)[k] = 0x5a;
+        FreeAlignedMemory(p);
+        ++*completed;
+    }
+    const size_t sizes[] = {1, 15, 16, 17, 2048, 65536, 522240, 1048576};
+    const size_t aligns[] = {16, 32, 64, 4096};
+    void *slots[32] = {};
+    // Texture-sized writes, interleaved lifetimes, and non-FIFO frees.
+    for (unsigned round = 0; round < 8; ++round) {
+        for (unsigned i = 0; i < 32; ++i) {
+            slots[i] = AllocateAlignedMemory(sizes[i % 8], aligns[i / 8]);
+            if (!slots[i] || (uintptr_t)slots[i] % aligns[i / 8]) return 1;
+            memset(slots[i], (unsigned char)(i + round), sizes[i % 8]);
+        }
+        for (unsigned j = 0; j < 32; ++j) {
+            unsigned i = (j * 13) % 32;
+            unsigned char *p = (unsigned char *)slots[i];
+            for (size_t k = 0; k < sizes[i % 8]; ++k)
+                if (p[k] != (unsigned char)(i + round)) return 2;
+            FreeAlignedMemory(slots[i]);
+            ++*completed;
+        }
+    }
+    FreeAlignedMemory(nullptr);
+    printf("TEXTURE_ALLOCATOR_PASS count=%u\n", *completed);
+    return 0;
+}
