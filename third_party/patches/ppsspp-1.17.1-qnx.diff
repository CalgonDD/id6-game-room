+#ifdef __QNX__
+// ID6 v23: alpha stats of the exact level-0 data handed to glTexImage2D.
+static void QNXUploadStats(GLRTexture *tex, const u8 *data, int w, int h, GLenum type) {
+	tex->qnxType = (int)type;
+	if (!data || w <= 0 || h <= 0)
+		return;
+	uint64_t sumA = 0, sumHi = 0;
+	int zero = 0;
+	const int n = w * h;
+	for (int i = 0; i < n; ++i) {
+		int a, hi;
+		if (type == GL_UNSIGNED_BYTE) {
+			a = hi = data[i * 4 + 3];
+		} else if (type == GL_UNSIGNED_SHORT_4_4_4_4) {
+			const u32 v = data[i * 2] | (data[i * 2 + 1] << 8);
+			a = (v & 0xF) * 17;
+			hi = ((v >> 12) & 0xF) * 17;
+		} else if (type == GL_UNSIGNED_SHORT_5_5_5_1) {
+			const u32 v = data[i * 2] | (data[i * 2 + 1] << 8);
+			a = (v & 1) ? 255 : 0;
+			hi = (v & 0x8000) ? 255 : 0;
+		} else if (type == GL_UNSIGNED_SHORT_5_6_5) {
+			a = hi = 255;
+		} else {
+			return;
+		}
+		sumA += a;
+		sumHi += hi;
+		if (a == 0)
+			zero++;
+	}
+	tex->qnxCpuA = (int)(sumA / n);
+	tex->qnxCpuHi = (int)(sumHi / n);
+	tex->qnxCpuZero = (int)((int64_t)zero * 100 / n);
+}
