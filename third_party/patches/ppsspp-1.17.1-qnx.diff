+// ID6 v23: sample the texture bound on unit 0 over a 16x16 grid into a private FBO and compare with its upload data.
+static void QNXTexProbe(GLRTexture *tex) {
+	static int probes, mismatches, noCpu, logged;
+	if (!qnxProbeReady || !tex || tex->qnxProbed || probes >= 0 || tex->target != GL_TEXTURE_2D || !tex->texture)  // ID6 v24: probe off
+		return;
+	tex->qnxProbed = 1;
+	probes++;
+
+	GLint fb = 0, prog = 0, arrayBuf = 0, activeTex = 0, attrOn = 0, packAlign = 4;
+	GLint vp[4] = {};
+	GLboolean colorMask[4] = { GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE };
+	glGetIntegerv(GL_FRAMEBUFFER_BINDING, &fb);
+	glGetIntegerv(GL_CURRENT_PROGRAM, &prog);
+	glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &arrayBuf);
+	glGetIntegerv(GL_ACTIVE_TEXTURE, &activeTex);
+	glGetIntegerv(GL_PACK_ALIGNMENT, &packAlign);
+	glGetIntegerv(GL_VIEWPORT, vp);
+	glGetBooleanv(GL_COLOR_WRITEMASK, colorMask);
+	glGetVertexAttribiv(qnxProbeAttr, GL_VERTEX_ATTRIB_ARRAY_ENABLED, &attrOn);
+	const GLenum caps[6] = { GL_BLEND, GL_DEPTH_TEST, GL_STENCIL_TEST, GL_CULL_FACE, GL_SCISSOR_TEST, GL_DITHER };
+	GLboolean capOn[6];
+	for (int i = 0; i < 6; ++i) {
+		capOn[i] = glIsEnabled(caps[i]);
+		glDisable(caps[i]);
+	}
+
+	static const GLfloat quad[8] = { -1.0f, -1.0f, 1.0f, -1.0f, -1.0f, 1.0f, 1.0f, 1.0f };
+	glActiveTexture(GL_TEXTURE0);
+	glBindFramebuffer(GL_FRAMEBUFFER, qnxProbeFbo);
+	glViewport(0, 0, 16, 16);
+	glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+	glUseProgram(qnxProbeProg);
+	glBindBuffer(GL_ARRAY_BUFFER, 0);
+	glEnableVertexAttribArray(qnxProbeAttr);
+	glVertexAttribPointer(qnxProbeAttr, 2, GL_FLOAT, GL_FALSE, 0, quad);
+	glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+	u8 px[16 * 16 * 4] = {};
+	glPixelStorei(GL_PACK_ALIGNMENT, 4);
+	glReadPixels(0, 0, 16, 16, GL_RGBA, GL_UNSIGNED_BYTE, px);
+	const GLenum err = glGetError();
+
+	if (!attrOn)
+		glDisableVertexAttribArray(qnxProbeAttr);
+	glBindBuffer(GL_ARRAY_BUFFER, (GLuint)arrayBuf);
+	glUseProgram((GLuint)prog);
+	glBindFramebuffer(GL_FRAMEBUFFER, (GLuint)fb);
+	glViewport(vp[0], vp[1], vp[2], vp[3]);
+	glColorMask(colorMask[0], colorMask[1], colorMask[2], colorMask[3]);
+	glPixelStorei(GL_PACK_ALIGNMENT, packAlign);
+	glActiveTexture((GLenum)activeTex);
+	for (int i = 0; i < 6; ++i) {
+		if (capOn[i])
+			glEnable(caps[i]);
+	}
+
+	int sumA = 0, sumRGB = 0, gpuZero = 0;
+	for (int i = 0; i < 256; ++i) {
+		sumA += px[i * 4 + 3];
+		sumRGB += (px[i * 4] + px[i * 4 + 1] + px[i * 4 + 2]) / 3;
+		if (px[i * 4 + 3] == 0)
+			gpuZero++;
+	}
+	const int gpuA = sumA / 256, gpuRGB = sumRGB / 256;
+	if (tex->qnxCpuA < 0)
+		noCpu++;
+	const bool mismatch = tex->qnxCpuA >= 0 && abs(tex->qnxCpuA - gpuA) > 40;
+	if (mismatch)
+		mismatches++;
+	if (probes <= 12 || (mismatch && logged < 40)) {
+		if (mismatch)
+			logged++;
+		NOTICE_LOG(G3D, "QNX_TPROBE n=%d name=%u %dx%d type=%x cpu_a=%d cpu_hi=%d cpu_zero=%d gpu_a=%d gpu_rgb=%d gpu_zero=%d min=%x mag=%x wrap=%x/%x mm=%d err=0x%x",
+			probes, (unsigned)tex->texture, tex->w, tex->h, tex->qnxType, tex->qnxCpuA, tex->qnxCpuHi, tex->qnxCpuZero, gpuA, gpuRGB,
+			gpuZero, (unsigned)tex->minFilter, (unsigned)tex->magFilter, (unsigned)tex->wrapS, (unsigned)tex->wrapT, mismatch ? 1 : 0,
+			(unsigned)err);
+	}
+	if (probes % 50 == 0)
+		NOTICE_LOG(G3D, "QNX_TPROBE_SUM probes=%d mismatch=%d no_cpu=%d", probes, mismatches, noCpu);
+}
